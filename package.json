{
  "name": "@clawkit/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ClawKit Monorepo — BNB Chain toolkit for AI agents",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "pnpm sync:integration-mirrors && turbo run test",
    "test:all": "pnpm sync:integration-mirrors && turbo run test",
    "deploy": "hardhat run scripts/deploy.ts --network opbnb",
    "lint": "turbo run lint",
    "check:deps": "node scripts/check-workspace-deps.mjs",
    "audit:duplicates": "node scripts/report-duplicates.mjs",
    "format": "prettier --write 'packages/*/{src,test}/**/*.{ts,tsx}'",
    "mcp": "pnpm --filter @clawkit/mcp dev",
    "start:mcp": "pnpm --filter @clawkit/mcp start",
    "mcp:preflight": "node scripts/mcp-rollout-preflight.mjs",
    "mcp:preflight:staging": "node scripts/mcp-rollout-preflight.mjs --profile staging",
    "mcp:preflight:production": "node scripts/mcp-rollout-preflight.mjs --profile production",
    "mcp:telemetry:report": "node scripts/mcp-telemetry-report.mjs",
    "mcp:phase-gate": "node scripts/runtime-phase-gate.mjs",
    "docker:build": "docker build -f packages/mcp/Dockerfile -t clawkit/mcp-server .",
    "sync:integration-mirrors": "node scripts/sync-integration-mirrors.mjs",
    "sync:integration-mirrors:check": "node scripts/sync-integration-mirrors.mjs --check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "keywords": [
    "openclaw",
    "bnb-chain",
    "opbnb",
    "ai-agent",
    "defi",
    "web3",
    "blockchain",
    "pancakeswap",
    "venus"
  ],
  "author": "ClawKit Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@pancakeswap/sdk": "^5.7.0",
    "@pancakeswap/smart-router": "^4.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.6.5",
    "better-sqlite3": "^9.4.0",
    "dotenv": "^16.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@clawkit/core": "workspace:^",
    "@clawkit/soul": "workspace:^",
    "@clawkit/toolkit": "workspace:^",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.1",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^8.56.0",
    "hardhat": "^2.19.4",
    "prettier": "^3.2.4",
    "tsx": "^4.21.0",
    "turbo": "^2.4.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clawkit/bnb"
  },
  "bugs": {
    "url": "https://github.com/clawkit/bnb/issues"
  },
  "homepage": "https://clawkit-bnb.dev",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
