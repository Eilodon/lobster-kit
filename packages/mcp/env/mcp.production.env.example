# MCP Production Profile (safe default)
NODE_ENV=production
LOG_LEVEL=info

COGNITIVE_TOOLS_ENABLED=true
REASON_CHAIN_ENABLED=true
CONTEXT_COMPRESSION_ENABLED=true
ORCHESTRATOR_ENABLED=false
TOOL_GEN_EXPERIMENTAL_ENABLED=false
TOOL_GEN_ORACLE_EXECUTION=false
TOOL_GEN_MAX_DYNAMIC_TOOLS=8

# Start conservative; increase gradually based on telemetry
COGNITIVE_CANARY_PERCENT=5
COGNITIVE_SHADOW_MODE_ENABLED=true
COGNITIVE_SHADOW_SAMPLE_PERCENT=100
COGNITIVE_AUTO_ROLLBACK_ERROR_RATE=0.12
COGNITIVE_AUTO_ROLLBACK_P95_MS=1800
COGNITIVE_AUTO_ROLLBACK_MIN_CALLS=50
