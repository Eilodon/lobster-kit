{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "composite": true,
        "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
        "resolveJsonModule": true,
        "typeRoots": [
            "../../node_modules/@types"
        ],
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*",
        "src/**/*.json"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
