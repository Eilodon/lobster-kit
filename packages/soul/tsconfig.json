{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "composite": true,
        "resolveJsonModule": true,
        "typeRoots": [
            "../../node_modules/@types"
        ]
    },
    "include": [
        "src/**/*",
        "src/**/*.json"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "core-rust",
        "pkg"
    ],
    "references": [
        {
            "path": "../core"
        }
    ]
}