# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Blockchain
PRIVATE_KEY=0x...
RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
CHAIN_ID=5611

# Oracles
CHAINLINK_ORACLE_ADDRESS=0x...

# APIs
GOPLUS_API_KEY=...
PANCAKESWAP_API_KEY=...

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Metrics
METRICS_PORT=9090

# Production Config (gitignored)
USE_PRODUCTION_PARAMS=false

# MCP Cognitive Rollout
COGNITIVE_TOOLS_ENABLED=true
REASON_CHAIN_ENABLED=true
CONTEXT_COMPRESSION_ENABLED=true
ORCHESTRATOR_ENABLED=false
TOOL_GEN_EXPERIMENTAL_ENABLED=false
TOOL_GEN_MAX_DYNAMIC_TOOLS=32
COGNITIVE_CANARY_PERCENT=100
COGNITIVE_AUTO_ROLLBACK_ERROR_RATE=0.35
COGNITIVE_AUTO_ROLLBACK_P95_MS=3000
COGNITIVE_AUTO_ROLLBACK_MIN_CALLS=20
