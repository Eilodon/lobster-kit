EIDOLON_GATEWAY_BIND=127.0.0.1:8787
EIDOLON_GATEWAY_KEYS=dev-key:default
# Optional HS256 JWT verification secret.
# EIDOLON_GATEWAY_JWT_SECRET=replace-with-strong-secret
EIDOLON_GATEWAY_ALLOW_ANON=false

EIDOLON_RATE_LIMIT_CAPACITY=60
EIDOLON_RATE_LIMIT_REFILL_PER_SEC=10
EIDOLON_QUOTA_MAX_REQUESTS_PER_DAY=100000

# Real inference routing (OpenAI-compatible APIs)
EIDOLON_GATEWAY_EXTERNAL_ENABLED=false
EIDOLON_GATEWAY_EXTERNAL_URL=https://api.openai.com/v1/chat/completions
EIDOLON_GATEWAY_EXTERNAL_API_KEY=
EIDOLON_GATEWAY_EXTERNAL_MODEL=gpt-4o-mini
EIDOLON_GATEWAY_EXTERNAL_TIMEOUT_SECS=20

# Local fallback provider (OpenAI-compatible server, e.g. local gateway/proxy)
EIDOLON_GATEWAY_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
EIDOLON_GATEWAY_LOCAL_API_KEY=
EIDOLON_GATEWAY_LOCAL_MODEL=qwen2.5:7b-instruct
EIDOLON_GATEWAY_LOCAL_TIMEOUT_SECS=20

# Critic gate
OUTPUT_CRITIC_ENABLED=true
OUTPUT_CRITIC_STRICT_MODE=false
OUTPUT_CRITIC_MIN_QUALITY_SCORE=0.3

EIDOLON_GATEWAY_STREAM_CHANNEL_CAPACITY=32
EIDOLON_GATEWAY_STREAM_TIMEOUT_MS=30000
