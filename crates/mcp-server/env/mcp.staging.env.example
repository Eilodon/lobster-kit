MCP_ENV_PROFILE=staging
MCP_PRIMARY_RUNTIME=rust
COGNITIVE_TOOLS_ENABLED=true
REASON_CHAIN_ENABLED=true
CONTEXT_COMPRESSION_ENABLED=true
ORCHESTRATOR_ENABLED=false
TOOL_GEN_EXPERIMENTAL_ENABLED=false
TOOL_GEN_ORACLE_EXECUTION=false
TOOL_GEN_ALLOWED_ENVS=development,staging
TOOL_GEN_MAX_DYNAMIC_TOOLS=16
TOOL_GEN_PROMOTE_MIN_CALLS=30
TOOL_GEN_PROMOTE_MAX_ERROR_RATE=0.15
TOOL_GEN_PROMOTE_MAX_P95_MS=1800
TOOL_GEN_PROMOTE_MAX_FALLBACK_RATE=0.2
TOOL_GEN_PROMOTE_MIN_SATISFACTION=0.7
COGNITIVE_CANARY_PERCENT=10
COGNITIVE_SHADOW_MODE_ENABLED=true
COGNITIVE_SHADOW_SAMPLE_PERCENT=100
COGNITIVE_AUTO_ROLLBACK_ERROR_RATE=0.20
COGNITIVE_AUTO_ROLLBACK_P95_MS=2200
COGNITIVE_AUTO_ROLLBACK_MIN_CALLS=30
COGNITIVE_RECOMMENDER_PRIMARY=v2
COGNITIVE_RECOMMENDER_SHADOW=v1
COGNITIVE_REASONING_LATENCY_BUDGET_MS=1200
# Optional ONNX runtime settings for embedding path:
# ORT_DYLIB_PATH=/absolute/path/to/libonnxruntime.so
# ONNX_MODEL_DIR=/absolute/path/to/crates/mcp-server/data/models/minilm
# Optional TensorOracle (Candle + GGUF) settings:
# TENSOR_ORACLE_GGUF_PATH=/absolute/path/to/.models/qwen3-1.7b-instruct-q4_k_m.gguf
# TENSOR_ORACLE_TOKENIZER_PATH=/absolute/path/to/.models/qwen3-tokenizer.json
# TENSOR_ORACLE_ALLOW_HF_DOWNLOAD=false

LEGACY_DEFI_COMPAT_ENABLED=false
LEGACY_DEFI_COMPAT_ALLOWED_ENVS=development
